# General Application Configuration
APP_ENV="development"
LOG_LEVEL="INFO" # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# --- LLM Provider Configuration ---
# Choose your primary LLM provider (e.g., OPENAI, ANTHROPIC, AZURE_OPENAI, HUGGINGFACE)
LLM_PROVIDER="OPENAI"
LLM_MODEL_NAME="gpt-4-turbo"
LLM_TEMPERATURE="0.7"
LLM_MAX_TOKENS="4096" # Max tokens for LLM generation

# OpenAI specific configuration
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
# OPENAI_BASE_URL="https://api.openai.com/v1" # Optional, override default OpenAI base URL

# Anthropic specific configuration
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"
# ANTHROPIC_MODEL_NAME="claude-3-opus-20240229" # Example Anthropic model if different from LLM_MODEL_NAME

# Azure OpenAI specific configuration
AZURE_OPENAI_API_BASE="https://YOUR_AZURE_OPENAI_RESOURCE_NAME.openai.azure.com/"
AZURE_OPENAI_API_KEY="YOUR_AZURE_OPENAI_API_KEY"
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4-turbo" # The deployment name of your model in Azure OpenAI
AZURE_OPENAI_API_VERSION="2024-02-01"

# Hugging Face specific configuration (for Inference Endpoints or gated models)
HF_API_TOKEN="YOUR_HUGGINGFACE_API_TOKEN"
# HUGGINGFACE_MODEL_NAME="mistralai/Mixtral-8x7B-Instruct-v0.1" # Example HF model if different from LLM_MODEL_NAME

# --- Embedding Service Configuration ---
# Model used for generating embeddings (e.g., "sentence-transformers/all-MiniLM-L6-v2", "text-embedding-ada-002")
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSIONS="384" # Expected output dimension of the embedding model.
# If using OpenAI embeddings, ensure OPENAI_API_KEY is set above.

# --- Graph Database Configuration ---
# Choose your graph database type (e.g., NEO4J, TIGERGRAPH, AURA_DB, etc.)
GRAPH_DB_TYPE="NEO4J"

# Neo4j specific configuration
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="password"
NEO4J_DATABASE="neo4j" # Default database name, can be changed if multiple databases are used

# --- Web UI & Human-in-the-Loop Configuration ---
WEB_UI_PORT="8000"
# Basic authentication for the Web UI (e.g., for annotators)
WEB_UI_USERNAME="admin"
WEB_UI_PASSWORD="secretpassword"
# PATH_TO_DOCUMENTS_FOR_INGESTION="/app/data/documents" # Example path for input documents

# --- Data Paths ---
# ROOT_DATA_DIR="./data" # Base directory for storing various data artifacts (e.g., parsed documents, temporary files)
# PATH_TO_PROMPT_TEMPLATES="./config/prompt_templates.py" # Or a directory if templates are files